# Cache rules, read by Cloudflare Pages and Netlify when the site goes live.
# The site is plain files: nothing is rebuilt on a visit. Photos and the vendored
# script never change under the same name (a changed photo gets a new file name),
# so browsers keep them for a year. Pages, styles.css and app.js keep the host's
# default (checked on each visit: one small "not modified" reply when nothing changed).
# Rules that match the same file are merged by both hosts, so there is no catch-all rule.

/images/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable
